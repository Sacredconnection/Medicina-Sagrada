# Set these in cPanel and in the shell used to build the application.
# Create this subdomain with DNS and HTTPS before using it.
NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://preview.medicinasagrada.com.br
WORDPRESS_SITE_URL=https://medicinasagrada.com.br
WORDPRESS_API_URL=https://medicinasagrada.com.br/wp-json
WOOCOMMERCE_STORE_API_URL=https://medicinasagrada.com.br/wp-json/wc/store/v1
WOOCOMMERCE_CHECKOUT_URL=https://medicinasagrada.com.br/checkout/
WOOCOMMERCE_ACCOUNT_URL=https://medicinasagrada.com.br/account/
CONTENT_REVALIDATE_SECONDS=900

# This isolates the frontend deployment only. Commerce still uses the live store.
# Leave newsletter and revalidation unconfigured until explicitly needed.
