# URL pública e canônica do novo frontend. Não use a URL de preview em produção.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Origem do WordPress. Antes do corte pode ser o domínio atual; depois, use o
# subdomínio onde o CMS continuar hospedado.
WORDPRESS_SITE_URL=https://medicinasagrada.com.br
WORDPRESS_API_URL=https://medicinasagrada.com.br/wp-json

# Use somente no servidor. Nunca prefixe estas variáveis com NEXT_PUBLIC_.
# O carrinho e o checkout existentes não precisam dessas credenciais.
# WORDPRESS_CONSUMER_KEY=
# WORDPRESS_CONSUMER_SECRET=

# Administração WordPress via API: usuário e senha de aplicação (não a senha de login).
# O diagnóstico usa este par separadamente das chaves WooCommerce.
# WP_USER=
# WP_PASSWORD=

# Opcional. Por padrão é derivada de WORDPRESS_API_URL.
WOOCOMMERCE_STORE_API_URL=https://medicinasagrada.com.br/wp-json/wc/store/v1

# Checkout e conta permanecem no WooCommerce com o Pagar.me já configurado.
# No corte de domínio, mudar para a origem do CMS; não apontar ao próprio Next.
WOOCOMMERCE_CHECKOUT_URL=https://medicinasagrada.com.br/checkout/
WOOCOMMERCE_ACCOUNT_URL=https://medicinasagrada.com.br/account/

# Segredo longo usado pelo webhook de revalidação do WordPress.
REVALIDATION_SECRET=

# Intervalo padrão de ISR em segundos.
CONTENT_REVALIDATE_SECONDS=900

# Produto escolhido manualmente para o mês. Vazio mantém "Em breve", sem preço.
# MONTHLY_PRODUCT_SLUG=

# Mailchimp: somente servidor. Novos contatos exigem confirmação por e-mail.
# MAILCHIMP_API_KEY=
# MAILCHIMP_AUDIENCE_ID=
# MAILCHIMP_SERVER_PREFIX=us21

# Limites compartilhados entre instâncias (API Redis REST compatível com Upstash).
# Sem estes valores, o limite funciona apenas por processo.
# RATE_LIMIT_REDIS_URL=
# RATE_LIMIT_REDIS_TOKEN=
# Fora da Vercel, use somente um cabeçalho sobrescrito pelo seu proxy confiável.
# RATE_LIMIT_IP_HEADER=
