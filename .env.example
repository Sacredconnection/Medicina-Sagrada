# URL pública e canônica do novo frontend. Não use a URL de preview em produção.
NEXT_PUBLIC_SITE_URL=https://medicinasagrada.com.br

# Origem do WordPress. Antes do corte pode ser o domínio atual; depois, use o
# subdomínio onde o CMS continuar hospedado.
WORDPRESS_SITE_URL=https://medicinasagrada.com.br
WORDPRESS_API_URL=https://medicinasagrada.com.br/wp-json

# Use somente no servidor. Nunca prefixe estas variáveis com NEXT_PUBLIC_.
WORDPRESS_CONSUMER_KEY=ck_substitua_pela_chave
WORDPRESS_CONSUMER_SECRET=cs_substitua_pelo_segredo

# Opcional. Por padrão é derivada de WORDPRESS_API_URL.
WOOCOMMERCE_STORE_API_URL=https://medicinasagrada.com.br/wp-json/wc/store/v1

# Segredo longo usado pelo webhook de revalidação do WordPress.
REVALIDATION_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Intervalo padrão de ISR em segundos.
CONTENT_REVALIDATE_SECONDS=900
