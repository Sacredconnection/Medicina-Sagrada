  "narrative": {
    "northStar": "Floresta, origem e clareza",
    "overview": "Este nome é uma síntese documental provisória, não uma nova direção aprovada.\nA vitrine combina fotografias, superfícies verdes profundas e áreas brancas de\nleitura. A descoberta é editorial; escolhas comerciais usam controles diretos,\npreços legíveis e feedback explícito. Proxima Nova é a base; títulos de intenções usam Georgia.",
    "keyCharacteristics": [
      "Fotografia como contexto de origem e descoberta.",
      "Verdes estruturais com acentos quentes em ações editoriais.",
      "Leitura clara e controles comerciais previsíveis.",
      "Acentos de etnias ligados ao conteúdo correspondente."
    ],
    "rules": [
      {
        "name": "Fixed principal colors",
        "body": "Verde #1A4020 e laranja #EF4929 são as duas cores principais fixas. Outros verdes e cores de etnias são somente apoios. Não substituir ou aproximar sem nova orientação explícita de Danilo.",
        "section": "colors"
      },
      {
        "name": "Contextual Accent",
        "body": "A cor de etnia acompanha somente o povo explicitamente identificado; não inferir origem de descrição livre.",
        "section": "colors"
      },
      {
        "name": "Action Context",
        "body": "Preserve o CTA de cada componente. Compra usa verde principal `#1a4020`; produto também usa `#1a4020` em repouso e laranja `#ef4929` em hover/foco; ações editoriais têm contorno e preenchimento animado. Não há regra global que torne todo botão laranja no mobile. brand-orange e cta-accent têm papéis distintos, com o mesmo HEX oficial `#ef4929`.",
        "section": "colors"
      },
      {
        "name": "Shared Voice",
        "body": "Reutilize Proxima Nova e os papéis existentes; preserve Georgia no contexto de intenções antes de criar uma família adicional.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do reutilizar tokens, fonte e componentes da superfície existente.",
      "Do conferir CTA em repouso, hover, foco e mobile antes de alterar sua cor.",
      "Do usar acento de etnia somente com identificação explícita e foreground canônico.",
      "Do respeitar nomes de assets e separar textos HTML de imagens de fundo.",
      "Do provar recortes e comportamento nas larguras relevantes."
    ],
    "donts": [
      "Don't tornar todos os CTAs laranja por uma regra genérica.",
      "Don't inventar origem, efeitos ou simbolismo cultural para sustentar o visual.",
      "Don't transformar divergência documental ou captura de loading em regra visual.",
      "Don't estender uma composição local de Aprenda ao resto da loja automaticamente."
    ]
  }
