      "css": ".ds-card{display:flex;max-width:19rem;overflow:hidden;flex-direction:column;border:1px solid white;border-radius:.75rem;background:white;text-decoration:none;transition:border-color 240ms ease,box-shadow 320ms cubic-bezier(.16,1,.3,1),transform 320ms cubic-bezier(.16,1,.3,1);font-family:var(--font-primary,\"proxima-nova\",\"Segoe UI\",Arial,sans-serif);}.ds-media{aspect-ratio:1;background:#f4f2ec}.ds-body{display:flex;min-height:12.25rem;padding:1.1rem;flex-direction:column}.ds-category{color:var(--brand-text,#c1371e);font-size:.75rem;font-weight:700;letter-spacing:.09em;text-transform:uppercase}.ds-body h3{color:var(--ink,#14251d);font-size:1.05rem;font-weight:600;letter-spacing:-.015em;line-height:1.28}.ds-product-action{display:flex;min-height:2.75rem;margin-top:auto;padding:.7rem .9rem;align-items:center;justify-content:center;border:1px solid var(--forest-900,#12372a);border-radius:.45rem;background:var(--forest-950,#0b261d);color:white;font-size:.75rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase}@media(hover:hover){.ds-card:hover{border-color:var(--forest-650,#3b6f52);box-shadow:0 .85rem 1.8rem rgba(11,38,29,.1);transform:translateY(-.18rem)}.ds-card:hover .ds-product-action{border-color:var(--cta-accent,#ef492b);background:var(--cta-accent,#ef492b);color:var(--cta-on-accent,#06140f)}}.ds-card:focus-visible{outline:.2rem solid var(--cta-accent,#ef492b);outline-offset:.25rem;border-color:var(--forest-650,#3b6f52);box-shadow:0 1.25rem 2.75rem rgba(11,38,29,.14);transform:translateY(-.2rem)}.ds-card:focus-visible .ds-product-action{background:var(--cta-accent,#ef492b);color:var(--cta-on-accent,#06140f)}.ds-card:active{transform:translateY(-.05rem)}"
